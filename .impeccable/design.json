  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action in a view or dialog; takes the project accent.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>New project</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:9px 15px;border-radius:999px;border:1px solid var(--accent-fill,#2f7258);background:var(--accent-fill,#2f7258);color:#fff;font:550 14px/1.25 Inter,-apple-system,sans-serif;box-shadow:0 0 0 1px color-mix(in srgb,var(--accent-source,#2f7258) 7%,transparent),0 3px 12px #0003;cursor:pointer;transition:background .15s,box-shadow .15s,transform .15s}.ds-btn-primary:hover{background:var(--accent-hover,#29644d)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#558c76);outline-offset:3px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting actions such as Import plan or Project setup.",
      "html": "<button class=\"ds-btn-secondary\">Import plan</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:9px 15px;border-radius:999px;border:1px solid var(--line,#303036);background:var(--surface,#19191d);color:var(--body-text,#c6c6cf);font:550 14px/1.25 Inter,-apple-system,sans-serif;cursor:pointer;transition:background .15s,border-color .15s,transform .15s}.ds-btn-secondary:hover{background:var(--surface-hover,#25252b);border-color:var(--border-hover,#51515e)}.ds-btn-secondary:active{transform:translateY(1px)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent,#558c76);outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis actions such as Cancel.",
      "html": "<button class=\"ds-btn-ghost\">Cancel</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;min-height:40px;padding:9px 15px;border-radius:999px;border:1px solid transparent;background:none;color:var(--body-text,#c6c6cf);font:550 14px/1.25 Inter,-apple-system,sans-serif;cursor:pointer;transition:background .15s}.ds-btn-ghost:hover{background:var(--surface-hover,#25252b)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent,#558c76);outline-offset:3px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Confirmed destructive actions only.",
      "html": "<button class=\"ds-btn-danger\">Delete project</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;min-height:40px;padding:9px 15px;border-radius:999px;border:1px solid transparent;background:#b85851;color:#fff;font:550 14px/1.25 Inter,-apple-system,sans-serif;cursor:pointer;transition:background .15s,transform .15s}.ds-btn-danger:hover{background:#a24741}.ds-btn-danger:active{transform:translateY(1px)}.ds-btn-danger:focus-visible{outline:2px solid #ff9b9b;outline-offset:3px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Dialog and form input with accent focus glow.",
      "html": "<label class=\"ds-field\">Project name<input class=\"ds-input\" placeholder=\"What are you working on?\"></label>",
      "css": ".ds-field{display:block;font:550 14px/1.5 Inter,-apple-system,sans-serif;color:var(--body-text,#c6c6cf);max-width:360px}.ds-input{display:block;width:100%;box-sizing:border-box;margin-top:7px;padding:10px 11px;border:1px solid var(--line,#303036);border-radius:6px;background:var(--surface,#19191d);color:var(--body-text,#c6c6cf);font:400 16px/1.5 Inter,-apple-system,sans-serif;outline:none}.ds-input::placeholder{color:var(--secondary-text,#aaaab7)}.ds-input:hover{border-color:var(--border-hover,#51515e)}.ds-input:focus{border-color:var(--accent,#558c76);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent-source,#2f7258) 12%,transparent)}"
    },
    {
      "name": "View Tabs",
      "kind": "nav",
      "refersTo": "view-tabs",
      "description": "Segmented control switching project views; the active view takes the accent soft tint.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab\">Components</button><button class=\"ds-tab ds-tab-active\" aria-selected=\"true\">Board</button><button class=\"ds-tab\">Gantt</button><button class=\"ds-tab\">Mind map</button><button class=\"ds-tab\">Software Factory</button></div>",
      "css": ".ds-tabs{display:inline-flex;gap:2px;padding:3px;border:1px solid var(--line,#303036);border-radius:999px;background:#1b1b20}.ds-tab{min-height:38px;padding:6px 12px;border:0;border-radius:999px;background:none;color:var(--body-text,#c6c6cf);font:400 14px/1.5 Inter,-apple-system,sans-serif;cursor:pointer}.ds-tab:hover{background:var(--surface-hover,#25252b)}.ds-tab:focus-visible{outline:2px solid var(--accent,#558c76);outline-offset:3px}.ds-tab-active{background:var(--accent-soft,#1c2424);color:var(--accent-soft-text,#60937f);font-weight:550;box-shadow:inset 0 0 0 1px var(--accent-border,#24463b)}"
    },
    {
      "name": "Blocked Badge",
      "kind": "chip",
      "refersTo": "",
      "description": "Warm amber badge for outstanding prerequisites; never alarm red.",
      "html": "<span class=\"ds-badge-blocked\">Blocked by 2</span>",
      "css": ".ds-badge-blocked{display:inline-flex;align-items:center;gap:4px;padding:3px 5px;border:1px solid #5e4b2d;border-radius:4px;background:#302719;color:#e8c58c;font:400 12px/1.5 Inter,-apple-system,sans-serif}"
    },
    {
      "name": "Task Card",
      "kind": "card",
      "refersTo": "task-card",
      "description": "Kanban card: priority, title, parent component, date and assignees.",
      "html": "<article class=\"ds-task-card\" tabindex=\"0\"><div class=\"ds-task-priority\">High</div><h3>Add Sea Areas</h3><div class=\"ds-task-parent\">SIS</div><div class=\"ds-task-footer\"><span class=\"ds-task-date\">27 Oct</span><span class=\"ds-avatar\">JW</span></div></article>",
      "css": ".ds-task-card{width:290px;box-sizing:border-box;padding:16px;border:1px solid var(--line,#303036);border-radius:14px;background:var(--surface,#19191d);color:var(--foreground,#ededf0);box-shadow:0 3px 8px #0002;font-family:Inter,-apple-system,sans-serif;cursor:grab;transition:border-color .15s,box-shadow .15s}.ds-task-card:hover{border-color:var(--accent-border,#24463b);box-shadow:0 4px 16px #0003}.ds-task-card:focus-visible{outline:2px solid var(--accent,#558c76);outline-offset:3px}.ds-task-priority{font-size:12px;color:#e7c786}.ds-task-card h3{margin:8px 0 0;font-size:16px;font-weight:600;line-height:1.5;letter-spacing:-.07px}.ds-task-parent{margin-top:7px;font-size:12px;color:var(--secondary-text,#aaaab7)}.ds-task-footer{display:flex;justify-content:space-between;align-items:center;margin-top:19px;font-size:14px;color:#ff9b9b}.ds-avatar{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--accent-soft,#1c2424);color:var(--accent-soft-text,#60937f);border:1px solid var(--accent-border,#24463b);font-size:12px}"
    },
    {
      "name": "Mind Map Root",
      "kind": "custom",
      "refersTo": "",
      "description": "Project root node: accent gradient, branch-colour left border.",
      "html": "<div class=\"ds-map-root\"><div class=\"ds-map-eyebrow\">YOUR PROJECT</div><div class=\"ds-map-title\">Supply Chain Intelligence</div><div class=\"ds-map-foot\">6 direct items</div></div>",
      "css": ".ds-map-root{width:220px;min-height:110px;box-sizing:border-box;display:flex;flex-direction:column;padding:18px 20px;border:1px solid var(--accent-border,#24463b);border-left:4px solid var(--accent,#558c76);border-radius:12px;background:linear-gradient(135deg,var(--accent-soft-strong,#1e2d2a),var(--accent-soft,#1c2424));color:var(--heading,#fafafa);font-family:Inter,-apple-system,sans-serif;box-shadow:0 4px 24px #0003}.ds-map-eyebrow{font-size:12px;font-weight:550;letter-spacing:.8px;color:var(--secondary-text,#aaaab7);margin-bottom:12px}.ds-map-title{font-size:18px;font-weight:600;line-height:1.5}.ds-map-foot{margin-top:auto;padding-top:10px;font-size:14px;color:var(--secondary-text,#aaaab7)}"
    },
    {
      "name": "Progress Ring",
      "kind": "custom",
      "refersTo": "",
      "description": "Conic completion ring in the project colour beside the project title.",
      "html": "<div class=\"ds-ring\" style=\"--progress:31%\"><span>31%</span></div>",
      "css": ".ds-ring{position:relative;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:conic-gradient(var(--accent,#558c76) var(--progress),var(--line,#303036) 0)}.ds-ring:before{content:\"\";position:absolute;inset:3px;border-radius:50%;background:var(--surface,#19191d)}.ds-ring>span{position:relative;font:550 12px/1 Inter,-apple-system,sans-serif;font-variant-numeric:tabular-nums;color:var(--body-text,#c6c6cf)}"
    }
  ],
  "narrative": {
    "northStar": "The Night Workshop",
    "overview": "Canopy is a charcoal bench after hours. The room is dark and quiet, and the one lit thing is the project in front of you: its colour runs through the active view tab, the selected nav item, avatars, the progress ring, the mind-map root and every focus ring. Everything else sits in layered greys so the work, not the chrome, holds the eye. Dark (\"React Flow\" theme) is the default; a light theme (\"Navy\", cool slate neutrals) offers the same structure in daylight.\n\nThe workshop is warm, not clinical. Warmth lives in the microcopy (\"A little room for what's next\", \"A little progress, one card at a time\"), in the sprout and tree marks, in earthy semantic tones (ochre for high priority, clay for urgent and overdue, amber for pending) instead of alarm red, and in small kindnesses such as a gentle radial glow behind the welcome panel. Density is moderate: a planner you work in all day, with 14px UI text, generous card padding and clear 1px boundaries.\n\nControls are soft-edged and steady. Buttons and tabs become pills in the dark theme, cards have gently rounded corners, and touch targets grow to 44px on phones. Nothing bounces or flourishes; motion is short and only confirms what you did.",
    "keyCharacteristics": [
      "Charcoal tonal layers with 1px lines; depth from tone first, soft shadow second.",
      "One accent at a time: the current project's colour, derived for contrast, with Canopy Green when no project applies.",
      "Inter throughout, tight negative tracking on headings, uppercase tracked eyebrows.",
      "Earthy, low-alarm semantic colour; warm copy in empty states and footers.",
      "Every pointer interaction has a keyboard path and a reduced-motion fallback."
    ],
    "rules": [
      {
        "name": "The One Lamp Rule",
        "body": "Only the current project's colour is used as an accent on a screen. Do not introduce a second brand hue; derived soft tints of the same colour are the only variation.",
        "section": "colors"
      },
      {
        "name": "The Derived Accent Rule",
        "body": "Never hard-code a project's accent. Read the `--accent*` custom properties, which are recalculated for contrast whenever the project colour or theme changes.",
        "section": "colors"
      },
      {
        "name": "The No Alarm Rule",
        "body": "Urgency, overdue and blocked states use earthy, muted tones (clay, ochre, amber), not saturated red. Saturated red is reserved for genuine error toasts.",
        "section": "colors"
      },
      {
        "name": "The Static Weights Rule",
        "body": "Only Inter 400, 500, 600 and 700 are loaded and `font-synthesis` is off. Weights written as 550 render as 600, and 650 as 700; prefer the loaded weights in new work.",
        "section": "typography"
      },
      {
        "name": "The Small Print Floor Rule",
        "body": "Keep readable text at 12px or larger. The 8 to 10px sizes in dense factory diagrams are an existing exception, not a pattern to extend.",
        "section": "typography"
      },
      {
        "name": "The Flat at Rest Rule",
        "body": "Panels, columns and toolbars carry no shadow; only cards, floating layers and selected nodes may lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take every accent from the derived `--accent*` properties so any project colour stays readable in both themes.",
      "Do build depth from the night floor, rail, graphite and raised graphite layers with 1px lines before reaching for a shadow.",
      "Do keep controls at 40px (44px on phones) with 6px or pill corners, and give every drag a keyboard path.",
      "Do write empty and status states in the warm, short voice already used (\"A little room for what's next\").",
      "Do check new work in both the dark and light themes and at 550px.",
      "Do keep motion between 0.12s and 0.25s with ease-out, and let `prefers-reduced-motion` switch it off."
    ],
    "donts": [
      "Don't introduce a second accent hue or hard-code `#2f7258` where the project colour should apply.",
      "Don't colour urgency or overdue with saturated red; use the earthy clay, ochre and amber tones.",
      "Don't reuse dependency gold for anything other than dependencies.",
      "Don't hard-code workflow status colours; they come from configuration.",
      "Don't add shadows to panels, columns or toolbars at rest.",
      "Don't set new text below 12px."
    ]
  }
}