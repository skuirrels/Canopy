{
  "FactoryTemplates": [
    {
      "id": "standard-implementation",
      "name": "Standard implementation",
      "description": "Prepare, implement, verify, review and accept. Configure the actual verification command before publishing.",
      "source": "Canopy factory-templates.json / standard-implementation / version 1",
      "definition": {
        "stages": [
          {
            "id": "prepare",
            "name": "Prepare work order",
            "group": "Prepare",
            "dependsOn": [],
            "steps": [
              {
                "id": "confirm",
                "name": "Confirm specification and acceptance criteria",
                "kind": "manual",
                "instructions": "Review the saved specification, acceptance criteria and configured inputs before execution."
              }
            ]
          },
          {
            "id": "build",
            "name": "Implement",
            "group": "Build",
            "dependsOn": [
              "prepare"
            ],
            "steps": [
              {
                "id": "implement",
                "name": "Implement the task",
                "kind": "agent",
                "role": "implementation",
                "permission": "workspace-write",
                "instructions": "Implement the task using the saved task specification and acceptance criteria.",
                "produces": [
                  "changes"
                ]
              }
            ]
          },
          {
            "id": "verify",
            "name": "Verify",
            "group": "Check",
            "dependsOn": [
              "build"
            ],
            "steps": [
              {
                "id": "checks",
                "name": "Run project verification",
                "kind": "command",
                "consumes": [
                  "changes"
                ],
                "produces": [
                  "verification"
                ]
              }
            ]
          },
          {
            "id": "review",
            "name": "Review evidence",
            "group": "Check",
            "dependsOn": [
              "verify"
            ],
            "steps": [
              {
                "id": "review",
                "name": "Review changes and verification evidence",
                "kind": "agent",
                "role": "review",
                "permission": "read-only",
                "instructions": "Review changes and verification evidence using the saved task specification and acceptance criteria.",
                "produces": [
                  "review-report"
                ],
                "consumes": [
                  "changes",
                  "verification"
                ]
              }
            ]
          },
          {
            "id": "handoff",
            "name": "Accept result",
            "group": "Hand off",
            "dependsOn": [
              "review"
            ],
            "steps": [
              {
                "id": "accept",
                "name": "Accept reviewed result",
                "kind": "manual",
                "instructions": "Inspect the diff, verification evidence and review report before accepting. Task status remains an explicit separate action.",
                "consumes": [
                  "review-report"
                ]
              }
            ]
          }
        ]
      }
    },
