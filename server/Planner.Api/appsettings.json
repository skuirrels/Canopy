{
  "Urls": "http://127.0.0.1:5274",
  "Database": { "Path": "data/planner.duckdb" },
  "Factory": { "TemplatesPath": "factory-templates.json", "Skills": [] },
  "Agents": {
    "CodexExecutable": "codex",
    "ClaudeExecutable": "claude",
    "GitExecutable": "git",
    "WorkspaceRoot": "data/agent-workspaces",
    "PollIntervalMs": 1500,
    "MaxRunMinutes": 30,
    "MaxOutputCharacters": 200000,
    "GitTimeoutSeconds": 30,
    "EffortLevels": {
      "codex": ["low", "medium", "high", "xhigh", "max", "ultra"],
      "claude": ["low", "medium", "high", "xhigh", "max"]
    },
    "EffortLevelsSources": {
      "codex": "https://learn.chatgpt.com/docs/config-file/config-reference#model_reasoning_effort",
      "claude": "https://code.claude.com/docs/en/model-config#adjust-effort-level"
    }
  },
  "Delivery": {
    "ApiBaseUrl": "https://api.github.com",
    "ApiVersion": "2026-03-10",
    "GitHubHost": "github.com",
    "GitHubExecutable": "gh",
    "TokenEnvironmentVariable": null,
    "RequestTimeoutSeconds": 30,
    "MaxResponseBytes": 2000000,
    "MaximumPages": 100,
    "Hooks": []
  },
  "WorkflowDefaults": [
    {"Name": "To Do", "Color": "#8b7cc8", "IsCompleted": false},
    {"Name": "In Progress", "Color": "#d9a441", "IsCompleted": false},
    {"Name": "Blocked", "Color": "#c35a61", "IsCompleted": false},
    {"Name": "In Testing", "Color": "#477fa1", "IsCompleted": false},
    {"Name": "Done", "Color": "#2f8b70", "IsCompleted": true}
  ],
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "localhost;127.0.0.1"
}
