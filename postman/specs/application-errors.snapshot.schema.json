{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canopy complete structured error snapshot",
  "description": "Producer-sanitized complete window. Identity/levels, freshness/window/event/byte bounds and conflicting IDs are also checked against the configured backend feed. Timestamps require explicit UTC offsets. No runtime sample data or automated redaction is provided.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "application",
    "environment",
    "generatedAt",
    "windowStart",
    "windowEnd",
    "complete",
    "sanitized",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "application": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "windowStart": {
      "type": "string",
      "format": "date-time"
    },
    "windowEnd": {
      "type": "string",
      "format": "date-time"
    },
    "complete": {
      "const": true
    },
    "sanitized": {
      "const": true
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "exceptionType",
          "messageTemplate",
          "frames",
          "occurrences"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "exceptionType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "messageTemplate": {
            "type": "string",
            "minLength": 1
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "symbol"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              }
            }
          },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "occurredAt",
                "level"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "occurredAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "level": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "release": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
