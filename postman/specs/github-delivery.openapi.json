                      "name",
                      "number"
                    ]
                  }
                },
                "required": [
                  "query",
                  "variables"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Merged PR identity or GraphQL errors; consumer requires complete matching identity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "repository": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
