    "/graphql": {
      "post": {
        "summary": "Read the authoritative merged PR commit identity",
        "description": "Read-only GitHub GraphQL query. REST 2026-03-10 omits merge_commit_sha. Errors and partial or mismatched identity are not evidence of a successful merge. Source: https://docs.github.com/en/graphql/reference/pulls#pullrequest",
