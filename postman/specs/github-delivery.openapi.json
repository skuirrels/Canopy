                                  "type": "integer"
                                },
                                "merged": {
                                  "type": "boolean"
                                },
                                "headRefOid": {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{40}$"
                                },
                                "mergeCommit": {
                                  "type": [
                                    "object",
                                    "null"
                                  ],
                                  "properties": {
                                    "oid": {
                                      "type": "string",
                                      "pattern": "^[a-f0-9]{40}$"
                                    }
                                  },
                                  "required": [
