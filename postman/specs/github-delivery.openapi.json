                  "variables": {
                    "type": "object",
                    "properties": {
                      "owner": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "number": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
