              "string"
            ],
            "format": "uuid"
          },
          "provider": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "specJson": {
